{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/v2/pkg/resources/gen.ResourceModel*/ -}}
{{- if .Hooks.ShowOutputSchema.Generate -}}
	map[string]*tfschema.Schema{
		ShowOutputAttributeName: {
			Type:        tfschema.TypeList,
			Computed:    true,
			Description: "Outputs the result of `SHOW {{ ToUpper (CamelToWords .Name) }}S` for the given {{ CamelToWords .Name }}.",
			Elem: &tfschema.Resource{
				Schema: schemas.Show{{ .Name }}Schema,
			},
		},
	},
{{ else if .Hooks.ShowOutputSchema.Present -}}
	{{ .Prefix }}ShowOutputSchemaExt,
{{ end -}}
