{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/v2/pkg/sdk/generator/gen.ShowProjection*/ -}}

{{- $nameLowerCase := FirstLetterLowercase .Source -}}
{{- $recv := FirstLetter $nameLowerCase -}}
func ({{ $recv }} *{{ .Source }}) {{ .Method }}() *{{ .Target }} {
	if {{ $recv }} == nil {
		return nil
	}
	return &{{ .Target }}{
		{{- range .Fields }}
		{{ . }}: {{ $recv }}.{{ . }},
		{{- end }}
	}
}
